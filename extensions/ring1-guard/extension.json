{
  "schema_version": 1,
  "id": "vemo.ring1-guard",
  "name": "Ring-1 guard adapter",
  "version": "1.0.0",
  "provides": [
    "vemo.platform.seam.ring1-guard"
  ],
  "requires": [
    "vemo.platform"
  ],
  "contributes": {
    "platform_seams": [
      {
        "id": "ring1_guard",
        "name": "Ring-1 guard adapter",
        "owner": "ingress",
        "roles": [
          {
            "id": "definition",
            "required": true,
            "minimum": 1,
            "paths": [
              "enforcement/hooks/hooks.json"
            ]
          },
          {
            "id": "provider",
            "required": false,
            "minimum": 1,
            "paths": [
              ".claude/settings.json",
              ".codex/hooks.json"
            ]
          },
          {
            "id": "consumer",
            "required": true,
            "minimum": 1,
            "paths": [
              "enforcement/hooks/run.py"
            ]
          }
        ]
      }
    ]
  }
}
