#!/usr/bin/env python3
"""Small CLI adapter for the VEMO governance kernel."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
os.environ.setdefault("VEMO_ROOT", str(ROOT))
sys.path.insert(0, str(ROOT / "enforcement"))
import core

CORE_COMMANDS = ("task", "check", "verify", "status", "init", "plugin")


def emit(value, code=0):
    print(json.dumps(value, ensure_ascii=False, indent=2))
    return code


def help_text(plugin_commands=None):
    descriptions = {
        "task": "create/show the current task authorization",
        "check": "evaluate an action or the staged/range diff",
        "verify": "run required commands and write snapshot-bound evidence",
        "status": "show the derived governance decision",
        "init": "initialize or migrate the minimal repository contract",
        "plugin": "list/enable/disable optional local plugins",
    }
    lines = ["vemo — Policy · Task · Gate · Verify · Evidence", "", "commands:"]
    lines.extend(f"  {name:8} {descriptions[name]}" for name in CORE_COMMANDS)
    if plugin_commands:
        lines.extend(["", "enabled plugin commands:"])
        lines.extend(f"  {name:8} plugin={row['plugin']}" for name, row in sorted(plugin_commands.items()))
    return "\n".join(lines)


def task_command(argv):
    parser = argparse.ArgumentParser(prog="vemo task")
    sub = parser.add_subparsers(dest="verb", required=True)
    create = sub.add_parser("create")
    create.add_argument("--id", required=True)
    create.add_argument("--scope", nargs="+", required=True)
    create.add_argument("--risk", choices=("normal", "critical"), default="normal")
    sub.add_parser("show")
    args = parser.parse_args(argv)
    if args.verb == "create":
        return emit(core.write_task(args.id, args.scope, args.risk, ROOT))
    task = core.load_task(ROOT)
    return emit({**task, "approval_digest": core.task_digest(task)})


def check_command(argv):
    parser = argparse.ArgumentParser(prog="vemo check")
    parser.add_argument("--action", choices=("write", "command")); parser.add_argument("--path")
    parser.add_argument("--command"); parser.add_argument("--content-stdin", action="store_true")
    parser.add_argument("--range"); parser.add_argument("--no-evidence", action="store_true")
    parser.add_argument("--self", action="store_true")
    args = parser.parse_args(argv)
    if args.self:
        try: return emit({"decision": "allow", "reason": "selfcheck_passed", "details": core.selfcheck(ROOT)})
        except core.VemoError as exc: return emit({"decision": "deny", "reason": "selfcheck_failed", "error": str(exc)}, 2)
    if args.action:
        content = sys.stdin.read() if args.content_stdin else None
        result = core.check_action(args.action, args.path, args.command, content, ROOT)
    else:
        result = core.check_merge(ROOT, args.range or os.environ.get("VEMO_DIFF_RANGE"), not args.no_evidence)
    return emit(result, 0 if result["decision"] == "allow" else 2)


def verify_command(argv):
    parser = argparse.ArgumentParser(prog="vemo verify"); parser.add_argument("--range")
    args = parser.parse_args(argv)
    try: result = core.verify(ROOT, args.range or os.environ.get("VEMO_DIFF_RANGE"))
    except core.VemoError as exc: return emit({"passed": False, "error": str(exc)}, 2)
    return emit(result, 0 if result["passed"] else 2)


def status_command():
    try:
        policy, task = core.load_policy(ROOT), core.load_task(ROOT)
        result = core.check_merge(ROOT, os.environ.get("VEMO_DIFF_RANGE"))
        return emit({"policy": core.POLICY_FILE, "task": task["id"], "risk": task["risk"],
                     "approval_digest": core.task_digest(task), "plugins": policy["plugins"], "merge": result})
    except core.VemoError as exc:
        return emit({"merge": {"decision": "deny", "reason": "configuration_invalid"}, "error": str(exc)}, 2)


def init_command(argv):
    parser = argparse.ArgumentParser(prog="vemo init"); parser.add_argument("--migrate", action="store_true")
    args = parser.parse_args(argv); (ROOT / core.EVIDENCE_DIR).mkdir(parents=True, exist_ok=True)
    migration = core.migrate(ROOT) if args.migrate or not (ROOT / core.TASK_FILE).exists() else {"changed": False, "path": core.TASK_FILE}
    if not (ROOT / core.TASK_FILE).exists():
        source = ROOT / "vemo.task.example.json"
        (ROOT / core.TASK_FILE).write_bytes(source.read_bytes())
        migration = {"changed": True, "path": core.TASK_FILE, "task": "T-example"}
    installer = ROOT / "enforcement" / "install.sh"
    result = subprocess.run(["bash", str(installer)], cwd=ROOT) if installer.is_file() else None
    return emit({"initialized": result is None or result.returncode == 0, "migration": migration},
                0 if result is None or result.returncode == 0 else 2)


def plugin_command(argv):
    parser = argparse.ArgumentParser(prog="vemo plugin"); sub = parser.add_subparsers(dest="verb", required=True)
    sub.add_parser("list")
    for verb in ("enable", "disable"):
        command = sub.add_parser(verb); command.add_argument("name")
    args = parser.parse_args(argv); manifests = core.plugin_manifests(ROOT); policy = core.load_policy(ROOT)
    if args.verb == "list":
        return emit({name: {"enabled": name in policy["plugins"], "commands": sorted(row["commands"])}
                     for name, row in manifests.items()})
    try: enabled = core.set_plugin(args.name, args.verb == "enable", ROOT)
    except core.VemoError as exc: return emit({"error": str(exc)}, 2)
    return emit({"plugins": enabled})


def run_plugin(spec, argv):
    entry, *fixed = spec["argv"]
    return subprocess.run([sys.executable, str(ROOT / entry), *fixed, *argv], cwd=ROOT).returncode


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    try: plugins = core.enabled_plugin_commands(ROOT)
    except core.VemoError as exc: return emit({"error": str(exc)}, 2)
    if not argv or argv[0] in {"-h", "--help", "help"}: print(help_text(plugins)); return 0
    command, rest = argv[0], argv[1:]
    try:
        if command == "task": return task_command(rest)
        if command == "check": return check_command(rest)
        if command == "verify": return verify_command(rest)
        if command == "status": return status_command()
        if command == "init": return init_command(rest)
        if command == "plugin": return plugin_command(rest)
        if command in plugins: return run_plugin(plugins[command], rest)
    except core.VemoError as exc:
        return emit({"error": str(exc)}, 2)
    print(help_text(plugins), file=sys.stderr); return 2


if __name__ == "__main__": raise SystemExit(main())
