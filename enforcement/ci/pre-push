#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
export VEMO_ROOT="$ROOT"
ZERO=0000000000000000000000000000000000000000
RANGE="${VEMO_DIFF_RANGE:-}"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO" ]; then
    [ -z "$RANGE" ] || { echo "[VEMO] push one ref at a time" >&2; exit 2; }
    RANGE="$remote_sha..$local_sha"
  fi
done
[ -n "$RANGE" ] || { echo "[VEMO] cannot determine push range" >&2; exit 2; }
exec python3 "$ROOT/bin/vemo" check --range "$RANGE"
