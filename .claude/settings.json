{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/enforcement/hooks/run.py\" edit", "timeout": 5}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/enforcement/hooks/run.py\" command", "timeout": 5}]
      }
    ]
  }
}
